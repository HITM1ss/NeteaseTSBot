# Unified configuration for tsbot (backend / web / voice-service)

# 后端服务配置
export TSBOT_HOST="127.0.0.1"
export TSBOT_PORT="8009"

# Backend -> voice-service gRPC address
export TSBOT_VOICE_GRPC_ADDR="127.0.0.1:50051"
export TSBOT_COOKIE_KEY="your_cookie_key"
# Optional shared-secret token(s) for backend API access.
# If set, non-admin backend routes require `Authorization: Bearer <token>` or `x-api-token`.
# export TSBOT_API_TOKEN="replace_with_a_long_random_token"
# export TSBOT_API_TOKENS="token_a,token_b"

# TeamSpeak 服务器配置（used by voice-service；历史变量名 `TSBOT_TS3_*` 也用于 TS6 主客户端连接）
export TSBOT_TS3_HOST="your_teamspeak_server_ip"
export TSBOT_TS3_PORT="9987"
export TSBOT_TS3_NICKNAME="tsbot"
export TSBOT_TS3_CHANNEL_ID="2"
export TSBOT_TS3_IDENTITY_FILE="./logs/identity.json"
# export TSBOT_TS3_IDENTITY=""
# export TSBOT_TS3_SERVER_PASSWORD=""
# export TSBOT_TS3_CHANNEL_PASSWORD=""
# export TSBOT_TS3_CHANNEL_PATH=""
# 模拟客户端资料：频道内显示名 / 简介 / 头像
# 开启后优先通过客户端自身的 `clientupdate` 写入描述，而不是依赖 ServerQuery。
# export TSBOT_TS3_ALLOW_DIRECT_CLIENTUPDATE_DESCRIPTION="1"
# 客户端描述头部（支持使用 \n 表示换行）
# export TSBOT_TS3_CLIENT_DESCRIPTION_TITLE="Yumi TSBot"
# 客户端介绍正文（支持使用 \n 表示换行）
# export TSBOT_TS3_CLIENT_DESCRIPTION_INTRO="TeamSpeak 音乐机器人\\n支持网易云 / QQ 音乐"
# 客户端头像：优先读取单文件；未设置时回退到头像目录中的第一张图片
# export TSBOT_TS3_AVATAR_FILE="./assets/avatar.png"
# export TSBOT_TS3_AVATAR_DIR="./assets/avatars"

# Optional legacy ServerQuery fallback for older servers only.
# This is NOT the TS6 HTTP(S) Query interface.
# export TSBOT_TS3_SERVERQUERY_USER=""
# export TSBOT_TS3_SERVERQUERY_PASSWORD=""
# export TSBOT_TS3_SERVERQUERY_HOST=""
# export TSBOT_TS3_SERVERQUERY_PORT="10011"
# export TSBOT_TS3_SERVERQUERY_SID=""
# export TSBOT_TS3_SERVERQUERY_USE_PORT="9987"

# Web production server (used by run-web.sh / nohup-start.sh)
export TSBOT_WEB_HOST="127.0.0.1"
export TSBOT_WEB_PORT="8080"
# export TSBOT_WEB_API_PROXY_TARGET="http://127.0.0.1:8009"
# export TSBOT_WEB_ALLOWED_HOSTS="dev.example.com,.example.com"

# Optional published image selection (used by docker-compose.prebuilt.yml)
# export TSBOT_IMAGE_REGISTRY="docker.io"
# export TSBOT_IMAGE_NAMESPACE="yumi118"
# export TSBOT_IMAGE_REPO="neteasetsbot"
# export TSBOT_IMAGE_TAG="latest"

# Web development server (used by npm run dev)
export VITE_DEV_HOST="127.0.0.1"
export VITE_DEV_PORT="5173"

# Frontend API base.
# Recommended default is same-origin `/api`; dev / preview / Docker will proxy it to backend.
export VITE_API_BASE="/api"
# 前端品牌 / 公网访问信息（重新 build 前端后生效）
# 网页公网 URL；用于 canonical / og:url，并会补充到 Vite allowedHosts
# export VITE_WEB_PUBLIC_URL="https://music.example.com"
# 网页显示名称；用于浏览器标题和侧边栏品牌
# export VITE_WEB_APP_NAME="Yumi TSBot"
# 网页图标；可为绝对 URL，或以 / 开头的站内路径
# export VITE_WEB_APP_ICON="/favicon.ico"
# If you enable TSBOT_API_TOKEN on the backend and still want the web UI to work,
# set the same token here before building/running the frontend.
# export VITE_API_TOKEN="replace_with_the_same_token"

# 音乐源配置
# 网易云功能依赖你自己部署的 NeteaseCloudMusicApi。
export TSBOT_NETEASE_API_BASE="http://127.0.0.1:3000/"
# B站单个视频允许播放的最长时长（分钟）；设为 0 可关闭限制。
# export TSBOT_BILIBILI_MAX_DURATION_MINUTES="180"
# QQ 音乐与网易云管理员 cookie 通过 Web 控制台或 admin API 写入数据库，
# 并使用 TSBOT_COOKIE_KEY 加密存储；无需在这里明文填写。

# 数据库配置
export DATABASE_URL="sqlite:///./tsbot.db"

# 开发模式 (true/false)
export DEBUG=false

# 日志配置
export TSBOT_LOG_LEVEL="INFO"
export TSBOT_LOG_FILE="logs/backend.log"
export VITE_LOG_LEVEL="INFO"
